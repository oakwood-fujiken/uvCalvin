<?xml version="1.0"?>
<!-- Round peg for robosuite NutAssembly task.
     A cylindrical peg on a base plate where the round nut is placed. -->
<robot name="round_peg">
  <link name="base_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.0"/>
      <inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1"/>
    </inertial>
    <!-- Base plate -->
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.08 0.08 0.005"/>
      </geometry>
      <material name="wood">
        <color rgba="0.6 0.3 0.1 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.08 0.08 0.005"/>
      </geometry>
    </collision>
  </link>

  <!-- Cylindrical peg -->
  <link name="peg">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.02"/>
      <geometry>
        <cylinder radius="0.02" length="0.04"/>
      </geometry>
      <material name="metal">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.02"/>
      <geometry>
        <cylinder radius="0.02" length="0.04"/>
      </geometry>
    </collision>
  </link>
  <joint name="peg_joint" type="fixed">
    <parent link="base_link"/>
    <child link="peg"/>
    <origin xyz="0 0 0.0025" rpy="0 0 0"/>
  </joint>
</robot>
