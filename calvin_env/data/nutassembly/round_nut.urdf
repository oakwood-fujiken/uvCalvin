<?xml version="1.0"?>
<!-- Round nut from robosuite NutAssembly task.
     A ring-shaped nut with a handle, made of steel-like material. -->
<robot name="round_nut">
  <link name="base_link">
    <contact>
      <lateral_friction value="0.95"/>
      <spinning_friction value="0.001"/>
    </contact>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <!-- Ring segment: -X -->
    <visual>
      <origin rpy="0 0 0" xyz="-0.04245 0 0"/>
      <geometry>
        <box size="0.0225 0.045 0.02"/>
      </geometry>
      <material name="steel">
        <color rgba="0.7 0.7 0.7 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="-0.04245 0 0"/>
      <geometry>
        <box size="0.0225 0.045 0.02"/>
      </geometry>
    </collision>
  </link>

  <!-- Ring segment: +X -->
  <link name="ring_px">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.0225 0.045 0.02"/>
      </geometry>
      <material name="steel">
        <color rgba="0.7 0.7 0.7 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.0225 0.045 0.02"/>
      </geometry>
    </collision>
  </link>
  <joint name="ring_px_joint" type="fixed">
    <parent link="base_link"/>
    <child link="ring_px"/>
    <origin xyz="0.04245 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Ring segment: -Y -->
  <link name="ring_ny">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.045 0.0225 0.02"/>
      </geometry>
      <material name="steel">
        <color rgba="0.7 0.7 0.7 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.045 0.0225 0.02"/>
      </geometry>
    </collision>
  </link>
  <joint name="ring_ny_joint" type="fixed">
    <parent link="base_link"/>
    <child link="ring_ny"/>
    <origin xyz="0 -0.04245 0" rpy="0 0 0"/>
  </joint>

  <!-- Ring segment: +Y -->
  <link name="ring_py">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.045 0.0225 0.02"/>
      </geometry>
      <material name="steel">
        <color rgba="0.7 0.7 0.7 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.045 0.0225 0.02"/>
      </geometry>
    </collision>
  </link>
  <joint name="ring_py_joint" type="fixed">
    <parent link="base_link"/>
    <child link="ring_py"/>
    <origin xyz="0 0.04245 0" rpy="0 0 0"/>
  </joint>

  <!-- Ring diagonal: -X -Y (rotated 45 degrees) -->
  <link name="ring_nxny">
    <visual>
      <origin rpy="0 0 0.785398" xyz="0 0 0"/>
      <geometry>
        <box size="0.0225 0.045 0.02"/>
      </geometry>
      <material name="steel">
        <color rgba="0.7 0.7 0.7 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0.785398" xyz="0 0 0"/>
      <geometry>
        <box size="0.0225 0.045 0.02"/>
      </geometry>
    </collision>
  </link>
  <joint name="ring_nxny_joint" type="fixed">
    <parent link="base_link"/>
    <child link="ring_nxny"/>
    <origin xyz="-0.03 -0.03 0" rpy="0 0 0"/>
  </joint>

  <!-- Ring diagonal: +X +Y (rotated 45 degrees) -->
  <link name="ring_pxpy">
    <visual>
      <origin rpy="0 0 0.785398" xyz="0 0 0"/>
      <geometry>
        <box size="0.0225 0.045 0.02"/>
      </geometry>
      <material name="steel">
        <color rgba="0.7 0.7 0.7 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0.785398" xyz="0 0 0"/>
      <geometry>
        <box size="0.0225 0.045 0.02"/>
      </geometry>
    </collision>
  </link>
  <joint name="ring_pxpy_joint" type="fixed">
    <parent link="base_link"/>
    <child link="ring_pxpy"/>
    <origin xyz="0.03 0.03 0" rpy="0 0 0"/>
  </joint>

  <!-- Ring diagonal: +X -Y (rotated 45 degrees) -->
  <link name="ring_pxny">
    <visual>
      <origin rpy="0 0 0.785398" xyz="0 0 0"/>
      <geometry>
        <box size="0.045 0.0225 0.02"/>
      </geometry>
      <material name="steel">
        <color rgba="0.7 0.7 0.7 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0.785398" xyz="0 0 0"/>
      <geometry>
        <box size="0.045 0.0225 0.02"/>
      </geometry>
    </collision>
  </link>
  <joint name="ring_pxny_joint" type="fixed">
    <parent link="base_link"/>
    <child link="ring_pxny"/>
    <origin xyz="0.03 -0.03 0" rpy="0 0 0"/>
  </joint>

  <!-- Ring diagonal: -X +Y (rotated 45 degrees) -->
  <link name="ring_nxpy">
    <visual>
      <origin rpy="0 0 0.785398" xyz="0 0 0"/>
      <geometry>
        <box size="0.045 0.0225 0.02"/>
      </geometry>
      <material name="steel">
        <color rgba="0.7 0.7 0.7 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0.785398" xyz="0 0 0"/>
      <geometry>
        <box size="0.045 0.0225 0.02"/>
      </geometry>
    </collision>
  </link>
  <joint name="ring_nxpy_joint" type="fixed">
    <parent link="base_link"/>
    <child link="ring_nxpy"/>
    <origin xyz="-0.03 0.03 0" rpy="0 0 0"/>
  </joint>

  <!-- Handle -->
  <link name="handle">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.0505 0.03175 0.02"/>
      </geometry>
      <material name="steel">
        <color rgba="0.7 0.7 0.7 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.0505 0.03175 0.02"/>
      </geometry>
    </collision>
  </link>
  <joint name="handle_joint" type="fixed">
    <parent link="base_link"/>
    <child link="handle"/>
    <origin xyz="0.06 0 0" rpy="0 0 0"/>
  </joint>
</robot>
